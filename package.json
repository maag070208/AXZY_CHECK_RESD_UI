{
  "name": "check_ui",
  "private": true,
  "license": "MIT",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 12345 --strictPort",
    "server": "vite preview --port 12345 --strictPort",
    "start": "yarn run build && yarn run server",
    "build": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "test": "vitest run",
    "test:e2e:mock": "playwright test",
    "test:e2e:mock:ui": "playwright test --ui",
    "test:e2e:real": "USE_REAL_API=true playwright test",
    "test:e2e:real:ui": "USE_REAL_API=true playwright test --ui",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@axzydev/axzy_ui_system": "1.1.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@stripe/react-stripe-js": "^2.5.0",
    "@stripe/stripe-js": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react-scroll-sync": "^0.9.0",
    "@vis.gl/react-google-maps": "^1.7.1",
    "ably": "^2.22.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "formik": "^2.4.6",
    "playwright": "^1.60.0",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-color": "^2.19.3",
    "react-confirm-alert": "^3.0.6",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "react-jwt": "^1.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "tailwindcss": "3",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "19.0.8",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react-swc": "3.8.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.6"
  }
}
